# Copy this file to .env and adjust the values. .env is git-ignored — never commit it.

# --- MySQL (used by Docker Compose and the Spring Boot app) ---
# Host port of the MySQL container (3307 avoids a clash with a local MariaDB on 3306)
DB_PORT=3307
# Database the app uses
DB_NAME=shotonloc
# Application user (the app connects with this one)
DB_USER=shotonloc
DB_PASSWORD=change-me
# Root password of the container (only for admin work, e.g. in DBeaver)
DB_ROOT_PASSWORD=change-me-too

# --- S3 object storage (RustFS locally, Cloudflare R2 in production) ---
# Host ports of the S3 API and the web console
S3_PORT=9000
S3_CONSOLE_PORT=9001
# Root credentials; also the login for the console at http://localhost:9001
S3_ACCESS_KEY=shotonloc
S3_SECRET_KEY=change-me-please
